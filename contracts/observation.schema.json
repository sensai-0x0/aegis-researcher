{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/observation.schema.json",
  "title": "AEGIS Observation",
  "description": "A reproducible FACT produced by a method against an in-scope target. Observations carry no claims: they are inputs to triage, never conclusions. Every observation must reference at least one evidence artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "run_id",
    "target",
    "method",
    "raw_evidence",
    "confidence",
    "created_at",
    "provenance"
  ],
  "properties": {
    "observation_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier"],
      "properties": {
        "kind": { "enum": ["host", "service", "component", "file", "process", "firmware_image", "agent_tool"] },
        "identifier": { "type": "string", "minLength": 1 }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker", "description"],
      "properties": {
        "worker": {
          "enum": ["system_inventory", "static_analysis", "application_testing", "fuzzing", "binary_analysis", "firmware", "qemu", "renode", "manual"]
        },
        "description": { "type": "string", "minLength": 5 },
        "tool": { "type": "string", "description": "Tool name + version used to produce this observation." },
        "command": { "type": "string", "description": "Reproduction command, if applicable." }
      }
    },
    "raw_evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Artifact IDs evidencing this observation. Rule evidence.md: an observation without evidence is invalid.",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "confidence": {
      "enum": ["low", "medium", "high"],
      "description": "Fidelity of the METHOD, not strength of any claim. Evidence fidelity only."
    },
    "hypothesis_id": {
      "type": ["string", "null"],
      "description": "Set when this observation was produced to test a hypothesis. Null for inventory observations."
    },
    "notes": { "type": "string", "description": "Factual context only. Claims belong on the finding/hypothesis ladder." },
    "created_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collected_by"],
      "properties": {
        "collected_by": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
