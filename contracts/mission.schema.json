{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/mission.schema.json",
  "title": "AEGIS Mission",
  "description": "An explicitly authorized research mission. The single source of truth for scope, rules of engagement and approval authority. Deny-by-default: anything not listed is not authorized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "objective",
    "authorized_targets",
    "exclusions",
    "rules_of_engagement",
    "constraints",
    "human_approvers",
    "status",
    "created_at",
    "provenance"
  ],
  "properties": {
    "mission_id": { "type": "string", "format": "uuid" },
    "objective": { "type": "string", "minLength": 10, "description": "What understanding this mission seeks. Stated in terms of verified knowledge, not activity." },
    "authorized_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["host", "cidr", "application", "component", "repository"] },
          "value": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "description": "Explicitly forbidden targets. Evaluated before authorized_targets.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["host", "cidr", "application", "component", "repository"] },
          "value": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "rules_of_engagement": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Human-readable binding constraints, e.g. 'no destructive testing', 'no third-party telemetry about the target'."
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact_limits"],
      "properties": {
        "time_budget": { "type": ["string", "null"] },
        "tool_restrictions": { "type": "array", "items": { "type": "string" } },
        "impact_limits": { "type": "string", "minLength": 5 },
        "max_concurrent_runs": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "human_approvers": {
      "type": "array",
      "minItems": 1,
      "description": "Who may approve consequential actions. Empty missions are invalid: consequential actions always need a named human.",
      "items": { "type": "string" }
    },
    "status": { "enum": ["draft", "active", "paused", "concluded"] },
    "created_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author"],
      "properties": {
        "author": { "type": "string" },
        "approved_by": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
