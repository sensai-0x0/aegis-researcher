{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/artifact.schema.json",
  "title": "AEGIS Artifact",
  "description": "An immutable, content-addressed evidence object. The sha256 IS the artifact id: the object lives at evidence/objects/<sha256[:2]>/<sha256>. Stored objects are never modified; corrections supersede via new manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "sha256",
    "media_type",
    "size",
    "produced_by",
    "source",
    "custody",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "The content address. Must equal sha256."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Required content hash. Evidence integrity outranks convenience."
    },
    "media_type": { "type": "string", "minLength": 3 },
    "size": { "type": "integer", "minimum": 0 },
    "produced_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id"],
      "properties": {
        "run_id": { "type": "string", "format": "uuid" },
        "worker": {
          "enum": ["system_inventory", "static_analysis", "application_testing", "fuzzing", "binary_analysis", "firmware", "qemu", "renode", "manual"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "description": "Reproduction command that produced this artifact." }
      }
    },
    "custody": {
      "type": "array",
      "minItems": 1,
      "description": "Chain of custody. Append-only: each event records actor, action, timestamp.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "action", "timestamp"],
        "properties": {
          "actor": { "type": "string" },
          "action": { "enum": ["collected", "stored", "verified", "exported", "superseded"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "note": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
